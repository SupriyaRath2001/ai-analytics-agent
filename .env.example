# Copy this file to .env and fill it in. Never commit .env.

# ---- LLM -------------------------------------------------------------
# Any LiteLLM model string works, e.g. "openai/<model>", "gemini/<model>",
# "anthropic/<model>". The fast model handles easy steps (routing, summaries,
# charts); the smart model writes and fixes SQL.
FAST_MODEL=
SMART_MODEL=
# LLM_API_KEY and LLM_API_BASE are used for BOTH models. To mix providers (say, a
# Gemini fast model and an Anthropic smart model), leave both empty and set each
# provider's own variable instead (OPENAI_API_KEY, GEMINI_API_KEY,
# ANTHROPIC_API_KEY, ...). LiteLLM reads those itself.
LLM_API_KEY=
# Optional: base URL of an OpenAI-compatible gateway (LiteLLM proxy, OpenRouter, ...)
LLM_API_BASE=

# ---- BigQuery --------------------------------------------------------
GCP_PROJECT=
# Path to a service-account key *inside the container*, e.g. /app/secrets/sa.json.
# Leave empty on a GCP VM: the VM's own service account is used.
GOOGLE_APPLICATION_CREDENTIALS=

# ---- App -------------------------------------------------------------
# Timezone used for "today", "last week", ... (cloud servers run on UTC by default)
TZ=UTC
# Address users open in the browser. Use http://localhost for local runs,
# or your domain (e.g. analytics.example.com) on the VM; Caddy gets HTTPS for it.
DOMAIN=http://localhost
# Leave empty when everything runs behind Caddy (links stay relative).
PUBLIC_BASE_URL=
# Shared key between Open WebUI and the agent API. Pick any long random string.
AGENT_API_KEY=change-me

# ---- Open WebUI ------------------------------------------------------
WEBUI_SECRET_KEY=change-me
# Full public URL of the chat UI, e.g. https://analytics.example.com
WEBUI_URL=http://localhost
# "Continue with Google": create an OAuth client in Google Cloud Console with the
# redirect URI <WEBUI_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
